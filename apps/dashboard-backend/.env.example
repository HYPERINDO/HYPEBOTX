NODE_ENV=development
PORT=4000

# Frontend URL dari aplikasi dashboard React
FRONTEND_URL=http://localhost:5173
# Backend URL untuk API auth + dashboard service
BACKEND_URL=http://localhost:4000

# Optional aliases untuk dukungan konfigurasi alternatif
# DASHBOARD_PUBLIC_URL biasanya sama dengan FRONTEND_URL
DASHBOARD_PUBLIC_URL=http://localhost:5173
# DASHBOARD_BASE_URL biasanya sama dengan BACKEND_URL
DASHBOARD_BASE_URL=http://localhost:4000

DATABASE_URL=
BOT_STORAGE_DIR=../../apps/bot/src/storage/temp
DASHBOARD_STORAGE_DIR=./logs/data

DASHBOARD_SESSION_SECRET=change-this-session-secret
DASHBOARD_COOKIE_SECURE=false
DASHBOARD_SESSION_TTL_MS=86400000

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:4000/api/auth/discord/callback
DISCORD_GUILD_ID=

OWNER_DISCORD_IDS=
ADMIN_ROLE_ID=
PENJOKI_ROLE_ID=

BOT_INTERNAL_API_KEY=
PAYMENT_SECRET=
