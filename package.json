{
  "name": "hypebotx-monorepo",
  "version": "1.0.0",
  "description": "HYPEBOTX professional Discord commerce monorepo",
  "private": true,
  "type": "commonjs",
  "workspaces": [
    "apps/bot",
    "apps/dashboard-frontend",
    "apps/dashboard-backend",
    "packages/shared",
    "packages/config"
  ],
  "scripts": {
    "dev:bot": "npm run dev --workspace=apps/bot",
    "dev:frontend": "npm run dev --workspace=apps/dashboard-frontend",
    "dev:backend": "npm run dev --workspace=apps/dashboard-backend",
    "dev:dashboard": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\"",
    "dev:all": "concurrently \"npm run dev:bot\" \"npm run dev:frontend\" \"npm run dev:backend\"",
    "start:bot": "npm run start --workspace=apps/bot",
    "start:backend": "npm run start --workspace=apps/dashboard-backend",
    "test": "npm run test:all",
    "test:bot": "npm run test --workspace=apps/bot",
    "test:frontend": "npm run test --workspace=apps/dashboard-frontend",
    "test:backend": "npm run test --workspace=apps/dashboard-backend",
    "test:all": "npm run test:bot && npm run test:frontend && npm run test:backend",
    "lint": "npm run lint:all",
    "lint:bot": "npm run lint --workspace=apps/bot",
    "lint:frontend": "npm run lint --workspace=apps/dashboard-frontend",
    "lint:backend": "npm run lint --workspace=apps/dashboard-backend",
    "lint:all": "npm run lint:bot && npm run lint:frontend && npm run lint:backend",
    "build": "npm run build:all",
    "build:frontend": "npm run build --workspace=apps/dashboard-frontend",
    "build:backend": "npm run build --workspace=apps/dashboard-backend",
    "build:all": "npm run build:frontend && npm run build:backend",
    "audit": "npm audit --audit-level=low --workspaces",
    "audit:all": "npm audit --workspaces",
    "check": "npm run lint:all && npm run test:all && npm run build:all",
    "qa:heavy": "npm run qa:heavy --workspace=apps/bot",
    "qa:chatbot-heavy": "npm run qa:chatbot-heavy --workspace=apps/bot",
    "qa:business": "npm run qa:business --workspace=apps/bot",
    "qa:features": "npm run qa:features --workspace=apps/bot",
    "qa:integration": "npm run qa:integration --workspace=apps/bot",
    "qa:security": "npm run qa:security --workspace=apps/bot",
    "qa:runtime": "npm run qa:runtime --workspace=apps/bot",
    "qa:staging": "npm run qa:staging --workspace=apps/bot",
    "qa:e2e": "npm run qa:e2e --workspace=apps/bot",
    "qa:all": "npm run qa:all --workspace=apps/bot",
    "qa:live:guild": "node scripts/live-discord-guild-audit.js",
    "qa:live:http": "node scripts/dashboard-http-audit.js",
    "qa:backup-restore": "node scripts/backup-restore-smoke.js",
    "qa:fix:order-center-perms": "node scripts/fix-order-center-permissions.js",
    "deploy": "npm run deploy --workspace=apps/bot",
    "refresh-commands": "npm run refresh-commands --workspace=apps/bot",
    "delete-commands": "npm run delete-commands --workspace=apps/bot",
    "seed:roles": "node scripts/seedRoles.js",
    "seed:channels": "node scripts/seedChannels.js",
    "seed:templates": "node scripts/seedTemplates.js",
    "verify:discord-env": "node scripts/verifyDiscordEnv.js",
    "pm2:start": "pm2 start infra/pm2/ecosystem.config.js",
    "pm2:stop": "pm2 stop infra/pm2/ecosystem.config.js",
    "pm2:restart": "pm2 restart infra/pm2/ecosystem.config.js --update-env",
    "pm2:delete": "pm2 delete infra/pm2/ecosystem.config.js",
    "pm2:logs": "pm2 logs hypebotx-bot --lines 100",
    "install:deps": "npm install"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "@discordjs/node-pre-gyp": {
      "tar": "7.5.15"
    }
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "eslint": "^10.4.0"
  }
}
