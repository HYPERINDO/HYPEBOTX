# HYPEBOTX monorepo root env reference.
# Copy this file to .env.local and fill in real IDs/secrets.
# Keep real secrets out of git.

# =========================
# GENERAL RUNTIME
# =========================
NODE_ENV=development
ENV_FILE=.env.local
DOTENV_CONFIG_QUIET=true
STARTUP_HACKER_BANNER=true
SLASH_COMMAND_MODE=standard

# =========================
# DISCORD BOT
# =========================
DISCORD_TOKEN=
CLIENT_ID=
GUILD_ID=
ALLOWED_GUILD_IDS=
RUNTIME_LOG_GUILD_ID=

# Roles
MEMBER_ROLE_ID=
VERIFIED_ROLE_ID=
VERIFY_ROLE_ID=
VERIFIED_ROLE_IDS=
OWNER_ROLE_ID=
STAFF_ROLE_ID=
ADMIN_ROLE_ID=
PENJOKI_ROLE_ID=

# Tickets / channels
TICKET_CATEGORY_ID=
TICKET_CATEGORY_NAME="Ticket Center"
TICKET_LOG_CHANNEL_ID=
TRANSCRIPT_CHANNEL_ID=
TICKET_USE_THREADS=true
PAYMENT_REVIEW_CHANNEL_ID=
PAYMENT_LOG_CHANNEL_NAME=payment-logs

# Store / payment
STORE_NAME=GameStore
DEFAULT_CURRENCY=IDR
DEFAULT_LOCALE=id-ID
DEFAULT_TIMEZONE=Asia/Jakarta
PAYMENT_BANK=
PAYMENT_EWALLET=
PAYMENT_QRIS=
PAYMENT_SECRET=

# AI / chatbot
OPENAI_API_KEY=
CHATBOT_MODE=rule
CHATBOT_PROVIDER=rule

# =========================
# STORAGE
# =========================
STORAGE_DRIVER=json
STORAGE_PROVIDER=json
DATABASE_PROVIDER=json
DATA_DIR=./data
DATABASE_DIR=./data
BACKUP_DIR=./src/storage/backups
TEMP_DIR=./src/storage/temp
TRANSCRIPT_DIR=./src/storage/transcripts
BOT_STORAGE_DIR=../../apps/bot/src/storage/temp
DASHBOARD_STORAGE_DIR=./logs/data

# =========================
# DASHBOARD
# =========================
# Final local dashboard split:
# - React UI: http://localhost:5173
# - Express API: http://localhost:4000
DASHBOARD_ENABLED=false
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=4000
OWNER_DASHBOARD_HOST=127.0.0.1
OWNER_DASHBOARD_PORT=8787
DASHBOARD_PUBLIC_URL=http://localhost:5173
DASHBOARD_BASE_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:4000
VITE_APP_NAME="HYPEBOTX Dashboard"
VITE_API_BASE_URL=http://localhost:4000
VITE_FRONTEND_URL=http://localhost:5173

# Discord OAuth for dashboard
DASHBOARD_GUILD_ID=
DASHBOARD_DISCORD_CLIENT_ID=
DASHBOARD_DISCORD_CLIENT_SECRET=
DASHBOARD_DISCORD_REDIRECT_URI=http://localhost:4000/api/auth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:4000/api/auth/discord/callback
OWNER_DISCORD_IDS=
DASHBOARD_SESSION_SECRET=
DASHBOARD_COOKIE_SECURE=false
DASHBOARD_SESSION_TTL_MS=28800000

# Optional internal API secrets
BOT_INTERNAL_API_KEY=

# Legacy/optional DB URL placeholder
DATABASE_URL=

# =========================
# CACHE / QUEUE
# =========================
REDIS_ENABLED=false
CACHE_PROVIDER=memory
REDIS_URL=redis://localhost:6379
BULL_ENABLED=false

# =========================
# PM2 / NODE
# =========================
PM2_INSTANCES=1
PM2_MAX_MEMORY_RESTART=700M
NODE_MAX_OLD_SPACE_SIZE_MB=512

# =========================
# BACKUP / JOBS
# =========================
BACKUP_MAX_COUNT=30
BACKUP_RETENTION_DAYS=30
JOKI_SWEEP_MS=60000

# =========================
# MONITORING / HEALTH
# =========================
MONITORING_ENABLED=true
MONITORING_PORT=3000
MONITORING_ALERT_THRESHOLD=0.8
MONITORING_RECOVERY_INTERVAL=30000
MONITORING_ERROR_RATE_WINDOW=300000

HEALTH_ALERT_ENABLED=true
HEALTH_ALERT_RECOVERY_ENABLED=true
HEALTH_ALERT_SEND_TO_DISCORD=false
HEALTH_ALERT_STATE_CHANGE_ONLY=true
HEALTH_ALERT_COOLDOWN_MS=300000
HEALTH_WARNING_COOLDOWN_MS=300000
HEALTH_CONSOLE_ALERT_ENABLED=true
HEALTH_CRASH_DETECTION_LOG_DETAILS=false
HEALTH_LOG_FULL_DETAILS=false
HEALTH_HEAPDUMP_ENABLED=false
HEALTH_HEAPDUMP_PATH=./src/storage/temp/heapdumps

HEALTH_MEMORY_WARNING_PERCENT=85
HEALTH_MEMORY_WARNING_MB=256
HEALTH_MEMORY_CRITICAL_PERCENT=90
HEALTH_MEMORY_CRITICAL_MB=512
HEALTH_MEMORY_EMERGENCY_GC_PERCENT=95
HEALTH_MEMORY_EMERGENCY_GC_MB=700
HEALTH_MEMORY_EMERGENCY_GC_COOLDOWN_MS=300000

# =========================
# ANTI-SPAM
# =========================
ANTI_SPAM_MESSAGE_THRESHOLD=5
ANTI_SPAM_MESSAGE_WINDOW=10000
ANTI_SPAM_MENTION_THRESHOLD=5
ANTI_SPAM_LINK_THRESHOLD=3
ANTI_SPAM_CAPS_THRESHOLD=0.8
ANTI_SPAM_TIMEOUT_DURATION=600000

# =========================
# ROLES / TEMPLATE STRICTNESS
# =========================
ROLE_TEMPLATE_STRICT=false
ROLE_TEMPLATE_ALLOWED_NAMES=

# =========================
# WEBHOOK LOGGING
# =========================
ERROR_WEBHOOK_URL=
DISCORD_LOG_WEBHOOK_LEVELS=ERROR,WARN
