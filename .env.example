DISCORD_TOKEN=
CLIENT_ID=
GUILD_ID=
ALLOWED_GUILD_IDS=

# Required role IDs for verify and ticket access.
# If you use role gate by ID, set these to the actual role IDs.
# At least one of VERIFIED_ROLE_ID, VERIFY_ROLE_ID, or VERIFIED_ROLE_IDS must be configured.
# VERIFIED_ROLE_IDS may contain comma-separated role IDs.
MEMBER_ROLE_ID=
VERIFIED_ROLE_ID=
VERIFY_ROLE_ID=
VERIFIED_ROLE_IDS=
OWNER_ROLE_ID=
STAFF_ROLE_ID=

# Required ticket channel/role IDs for message routing and transcripts.
TICKET_CATEGORY_ID=
TICKET_LOG_CHANNEL_ID=
TRANSCRIPT_CHANNEL_ID=
TICKET_CATEGORY_NAME=🎟️ TICKET CENTER
TICKET_USE_THREADS=true

OPENAI_API_KEY=

STORE_NAME=GameStore
DEFAULT_CURRENCY=IDR
PAYMENT_BANK=BCA - 1234567890 a.n. GameStore
PAYMENT_EWALLET=DANA / OVO / GoPay - 081234567890
PAYMENT_QRIS=-

STORAGE_DRIVER=json
DATA_DIR=./data
DATABASE_DIR=./data
PM2_INSTANCES=1
NODE_ENV=development
MUSIC_ENABLED=true

DASHBOARD_ENABLED=false
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=3001
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=

# Optional runtime settings
REDIS_ENABLED=false
CACHE_PROVIDER=memory

# Optional monitoring and logging
ERROR_WEBHOOK_URL=
DISCORD_LOG_WEBHOOK_LEVELS=ERROR,WARN

# Crash detection thresholds
HEALTH_MEMORY_WARNING_PERCENT=85
HEALTH_MEMORY_WARNING_MB=256
HEALTH_MEMORY_CRITICAL_PERCENT=90
HEALTH_MEMORY_EMERGENCY_GC_PERCENT=95
HEALTH_MEMORY_EMERGENCY_GC_MB=700

# PM2 runtime memory profile (1GB VPS defaults)
PM2_MAX_MEMORY_RESTART=700M
NODE_MAX_OLD_SPACE_SIZE_MB=512
