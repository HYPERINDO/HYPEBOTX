FROM node:22-bookworm-slim AS build

WORKDIR /app

COPY package*.json ./
COPY apps/dashboard-frontend/package.json ./apps/dashboard-frontend/package.json
COPY packages/shared/package.json ./packages/shared/package.json
COPY packages/config/package.json ./packages/config/package.json

RUN npm ci --workspace=apps/dashboard-frontend

COPY apps/dashboard-frontend ./apps/dashboard-frontend
COPY packages ./packages

RUN npm run build --workspace=apps/dashboard-frontend

FROM nginx:1.27-alpine

COPY infra/nginx/dashboard.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/apps/dashboard-frontend/dist /usr/share/nginx/html

EXPOSE 80
